# Core runtime
# Keep preview mode on for the first local validation pass.
PORT=3000
DB_DIR=./data
PREVIEW_MODE=true

# Required in preview and live mode
USER_ADDRESSES=0x1234567890abcdef1234567890abcdef12345678
PROXY_WALLET=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd
RPC_URL=https://polygon-bor-rpc.publicnode.com
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
CLOB_HTTP_URL=https://clob.polymarket.com/
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws

# Required only for live mode
# Leave blank during the first preview-mode validation pass.
PRIVATE_KEY=
LIVE_SMOKE_CONFIRM=

# Execution controls
FETCH_INTERVAL=1
RETRY_LIMIT=3
NETWORK_RETRY_LIMIT=3
REQUEST_TIMEOUT_MS=10000
TOO_OLD_TIMESTAMP=24
SLIPPAGE_TOLERANCE=0.05
DAILY_LOSS_CAP_PCT=20
KILL_SWITCH_MAX_ERRORS=5

# Copy strategy
COPY_STRATEGY=PERCENTAGE
COPY_SIZE=10
MAX_ORDER_SIZE_USD=100
MIN_ORDER_SIZE_USD=1
MAX_POSITION_SIZE_USD=500
# Optional additional cap
# MAX_DAILY_VOLUME_USD=1000

# Optional aggregation
TRADE_AGGREGATION_ENABLED=false
TRADE_AGGREGATION_WINDOW_SECONDS=10

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live mode note
# Set PREVIEW_MODE=false only after:
# 1. validate:handoff passes
# 2. health check passes with your real config
# 3. local data backup strategy is in place
# 4. Set LIVE_SMOKE_CONFIRM=I_HAVE_BACKED_UP_DATA before running npm run smoke:live:preflight
